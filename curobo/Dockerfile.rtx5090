# cuRobo + ROS2 Humble Docker — RTX 5090 (Blackwell, sm_120) 호환
#
# 변경 사항 (기존 Dockerfile 대비):
#   - CUDA 12.8 base image (nvcc가 compute_120 지원)
#   - PyTorch cu128 (sm_120 네이티브 지원)
#   - TORCH_CUDA_ARCH_LIST="12.0" (RTX 5090)
#
# 빌드:
#   cd curobo && docker build -f Dockerfile.rtx5090 -t curobo-ros2:latest .
#
# 실행:
#   ./docker_start.sh

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 미러 설정
RUN sed -i 's/archive.ubuntu.com/mirror.kakao.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirror.kakao.com/g' /etc/apt/sources.list

# ── 기본 패키지 + Python 3.10 ────────────────────────────
RUN apt-get update && apt-get install -y \
      python3 python3-pip python3-dev \
      software-properties-common curl gnupg lsb-release \
      git build-essential ninja-build && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    pip3 install --no-cache-dir --upgrade pip setuptools && \
    rm -rf /var/lib/apt/lists/*

# ── PyTorch 설치 (CUDA 12.8 호환, sm_120 지원) ──────────────
RUN pip install --no-cache-dir \
    torch torchvision --index-url https://download.pytorch.org/whl/cu128

# ── ROS2 Humble 설치 ────────────────────────────────────
RUN apt-get update && \
    add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc \
      | gpg --batch --dearmor -o /usr/share/keyrings/ros2-latest-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros2-latest-archive-keyring.gpg] \
      http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
      > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && \
    apt-get install -y \
      ros-humble-ros-base \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-sensor-msgs \
      ros-humble-geometry-msgs \
      ros-humble-std-srvs \
      ros-humble-trajectory-msgs \
      ros-humble-control-msgs \
      ros-humble-tf2-ros \
      ros-humble-visualization-msgs \
      python3-colcon-common-extensions \
      python3-rosdep && \
    rm -rf /var/lib/apt/lists/*

# rosdep 초기화
RUN rosdep init 2>/dev/null || true && rosdep update

# ── cuRobo 설치 (GitHub 소스에서 빌드) ────────────────────
# torch를 제외한 의존성만 먼저 설치
RUN pip install --no-cache-dir \
    numpy-quaternion trimesh networkx warp-lang yourdfpy scipy

ENV TORCH_CUDA_ARCH_LIST="12.0"
RUN git clone https://github.com/NVlabs/curobo.git /tmp/curobo && \
    cd /tmp/curobo && \
    pip install --no-cache-dir --no-build-isolation --no-deps . && \
    rm -rf /tmp/curobo

# ── 환경 설정 ────────────────────────────────────────────
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /root/ws/install/setup.bash 2>/dev/null" >> /root/.bashrc

WORKDIR /root/ws
